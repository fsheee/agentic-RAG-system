# ---------------------------------------------------------------------------
# Copy this file to .env.local and keep exactly ONE active line below.
#   cp .env.example .env.local
#
# NEXT_PUBLIC_API_URL = base URL of the FastAPI backend (not Qdrant, not Neon).
# Rules:
#   - one URL only: a comma-separated list or a second line breaks the app
#   - no trailing slash (lib/api.ts appends paths like "/auth/login")
#   - restart `npm run dev` after editing; Next.js reads it at startup
# ---------------------------------------------------------------------------

# 1) Local development (backend: uv run uvicorn app.api:app --reload)
NEXT_PUBLIC_API_URL=http://localhost:8000

# 2) Deployed backend - use this INSTEAD of the line above, not as well.
# NEXT_PUBLIC_API_URL=https://agentic-rag-with-gemini-embedding-m.vercel.app

# NOTE: the live site does NOT read this file. For production set
# NEXT_PUBLIC_API_URL in Vercel -> project `agentic-ragsystem` ->
# Settings -> Environment Variables, then redeploy.
