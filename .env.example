# ---- LLM provider: Groq ----
GROQ_API_KEY=your_groq_api_key
MODEL_NAME=openai/gpt-oss-120b

# ---- LLM provider: Gemini (used when GOOGLE_API_KEY is set) ----
GOOGLE_API_KEY=your_google_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# ---- Embeddings ----
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional pool tuning (defaults shown). pool_pre_ping is always on.
# POOL_RECYCLE_SECONDS=1800
# POOL_SIZE=5
# POOL_MAX_OVERFLOW=10
# POOL_TIMEOUT_SECONDS=30

# ---- Request / LLM hardening (defaults shown) ----
# Largest accepted request body, in bytes (413 above it).
# MAX_REQUEST_BODY_BYTES=1048576
# Per-attempt LLM timeout and retries for transient failures.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag




# ---- Vector store (Qdrant) ----
# Set QDRANT_URL to use a running Qdrant server; leave empty for local mode (qdrant_data/)
# QDRANT_URL=
# Local-mode folder. Defaults to <repo>/qdrant_data (cwd-independent).
# QDRANT_PATH=
# QDRANT_COLLECTION_NAME=your_collection_name
JWT_SECRET=test-secret-for-dev-only
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password

# ---- Frontend / CORS ----
# Origins allowed to call the API (comma-separated). Must match the Next.js URL.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
