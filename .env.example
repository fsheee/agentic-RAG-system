# ---- LLM provider: Groq ----
GROQ_API_KEY=your_groq_api_key
MODEL_NAME=openai/gpt-oss-120b

# ---- LLM provider: Gemini (used when GOOGLE_API_KEY is set) ----
GOOGLE_API_KEY=your_google_api_key
# Rolling alias: tracks a maintained Flash-Lite model, so a pinned version
# going overloaded (503 UNAVAILABLE) cannot take the whole API down.
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Embeddings ----
# Gemini API embeddings are the default and need no local ML runtime:
EMBEDDING_MODEL=models/gemini-embedding-001
# Local HuggingFace embeddings require the optional extra:
#   uv sync --extra local-embeddings
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional pool tuning (defaults shown). pool_pre_ping is always on.
# POOL_RECYCLE_SECONDS=1800
# POOL_SIZE=5
# POOL_MAX_OVERFLOW=10
# POOL_TIMEOUT_SECONDS=30

# ---- Request / LLM hardening (defaults shown) ----
# Largest accepted request body, in bytes (413 above it).
# MAX_REQUEST_BODY_BYTES=1048576
# Per-attempt LLM timeout and retries for transient failures.
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Per-IP request window, all paths except /health.
# RATE_LIMIT_PER_MINUTE=60
# LOG_LEVEL=INFO

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=agentic-rag

# ---- Vector store (Qdrant) ----
# Set QDRANT_URL to use a running Qdrant server; leave empty for local mode (qdrant_data/).
# QDRANT_URL=
# Required when QDRANT_URL points at Qdrant Cloud.
# QDRANT_API_KEY=
# Local-mode folder. Defaults to <repo>/qdrant_data (cwd-independent).
# QDRANT_PATH=
# Prefix for the collection name (read by config.py).
# QDRANT_COLLECTION_PREFIX=

# ---- Auth ----
# Required. Generate one, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
# JWT_EXPIRE_MINUTES=60
# Initial admin created by app.seed (skipped when unset).
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me

# ---- Frontend / CORS ----
# Browser origins allowed to call the API (comma-separated, exact, NO trailing slash).
# The frontend's API base URL is configured separately in frontend/.env.local
# (NEXT_PUBLIC_API_URL) — never here.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: replace the line above with the deployed frontend origin.
# ALLOWED_ORIGINS=https://agentic-ragsystem.vercel.app
